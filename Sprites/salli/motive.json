{
  "format": "motive/1",
  "metadata": {
    "id": "salli",
    "name": "Salli",
    "description": "Created in Fido's pet studio.",
    "license": "MIT",
    "version": "1.0.0"
  },
  "atlases": {
    "sprite": { "path": "spritesheet.png", "cell": [192, 208], "grid": [25, 9] }
  },
  "states": {
    "idle":          { "frames": { "row": 0, "count": 25 }, "ms": 100, "purpose": "resting loop, breathing and blinking" },
    "running-right": { "frames": { "row": 1, "count": 25 }, "ms": 60,  "purpose": "dashing to the right" },
    "running-left":  { "frames": { "row": 2, "count": 25 }, "ms": 60,  "purpose": "dashing to the left" },
    "waving":        { "frames": { "row": 3, "count": 25 }, "ms": 80,  "interrupt": "after-loop", "purpose": "friendly greeting wave" },
    "jumping":       { "frames": { "row": 4, "count": 25 }, "ms": 70,  "interrupt": "after-loop", "purpose": "excited jump" },
    "failed":        { "frames": { "row": 5, "count": 25 }, "ms": 90,  "purpose": "something went wrong: dismay" },
    "waiting":       { "frames": { "row": 6, "count": 25 }, "ms": 120, "purpose": "expectant, looking at the viewer for input" },
    "running":       { "frames": { "row": 7, "count": 25 }, "ms": 70,  "purpose": "hard at work" },
    "review":        { "frames": { "row": 8, "count": 25 }, "ms": 80,  "purpose": "calm satisfaction, work finished" }
  },
  "aliases": { "working": "running", "done": "review", "error": "failed" },
  "triggers": {
    "wave": { "state": "waving", "once": true, "purpose": "play the waving gesture once, then return" },
    "jump": { "state": "jumping", "once": true, "purpose": "play the jump once, then return" }
  },
  "transitions": [{ "from": "*", "to": "*", "ms": 180 }]
}
