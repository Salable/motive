.DS_Store
.build/
dist/
.worktrees/
.motive-home/
# Any local runtime home: these hold a live bearer token and a record of
# whatever the companion was asked. Broad on purpose — a one-off name like
# .motive-verify must not slip past this.
.motive-*/
*.xcodeproj
xcuserdata/
.swiftpm/
Package.resolved

# Companions assembled from Kit/ — local builds, deliberately not shared.
# Each is a standalone package depending on the published release, so there is
# nothing here another checkout needs (see Apps/README.md).
Apps/*
!Apps/README.md

# Pre-rewrite reference material, not part of the published repo.
FIRST_ATTEMPT/
SPRITE_EXAMPLES/
SPEC.md
.claude/
