+void native_sdk_appkit_update_tray_icon(native_sdk_appkit_host_t *host, const char *icon_path, size_t icon_path_len) {
+    NativeSdkAppKitHost *object = (__bridge NativeSdkAppKitHost *)host;
+    @autoreleasepool {
+        if (!object.statusItem) return;
+        if (!icon_path || icon_path_len == 0) {
+            object.statusItem.button.image = nil;
+            return;
+        }
+        NSString *path = [[NSString alloc] initWithBytes:icon_path length:icon_path_len encoding:NSUTF8StringEncoding];
+        NSImage *image = path ? [[NSImage alloc] initWithContentsOfFile:path] : nil;
+        if (image) {
+            // Same template treatment as create: monochrome adaptive
+            // glyph at the standard status-item point size.
+            image.template = YES;
+            image.size = NSMakeSize(18, 18);
+            object.statusItem.button.image = image;
+        }
     }
 }
 
