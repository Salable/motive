.{
    .id = "dev.native_sdk.talkbox",
    .name = "TalkBox",
    .display_name = "TalkBox",
    .description = "TalkBox speaks queued text aloud: agents POST to a local REST API and a supervised speaker sidecar plays each item.",
    .version = "0.8.0",
    .icons = .{"assets/icon.svg"},
    .platforms = .{"macos"},
    // "microphone" gates the reply composer's voice path (Settings ->
    // Replies). The SDK validates this but doesn't enforce it at
    // runtime yet - the real gate is macOS's own mic + speech-
    // recognition TCC prompts inside the listener sidecar.
    .permissions = .{ "view", "command", "microphone" },
    .capabilities = .{ "native_views", "gpu_surfaces", "menus", "shortcuts", "tray" },
    // Every OS entry point (menu bar, shortcuts, tray rows) dispatches a
    // command id through one on_command router in main.zig.
    .commands = .{
        .{ .id = "tts.play_pause", .title = "Toggle Playback" },
        .{ .id = "tts.skip", .title = "Skip" },
        .{ .id = "tts.clear", .title = "Clear Queue" },
        .{ .id = "tts.settings", .title = "Settings…" },
        .{ .id = "tts.play", .title = "Play" },
        .{ .id = "tts.show_queue", .title = "Show Queue" },
        .{ .id = "tts.show_settings", .title = "View Settings" },
    },
    .shortcuts = .{
        .{ .id = "tts.settings", .key = ",", .modifiers = .{"primary"} },
        .{ .id = "tts.skip", .key = "e", .modifiers = .{"primary"} },
        .{ .id = "tts.clear", .key = "k", .modifiers = .{"primary"} },
    },
    .menus = .{
        .{
            .title = "Queue",
            .items = .{
                .{ .label = "Toggle Playback", .command = "tts.play_pause" },
                .{ .label = "Skip", .command = "tts.skip", .key = "e", .modifiers = .{"primary"} },
                .{ .label = "Clear Queue", .command = "tts.clear", .key = "k", .modifiers = .{"primary"} },
            },
        },
    },
    // NOTE: main.zig builds the runtime scene programmatically; this
    // shell block MUST mirror it (the runner reads it for startup
    // chrome: titlebar, sizes, restore behavior).
    .shell = .{
        .windows = .{
            .{
                .label = "main",
                .title = "TalkBox",
                .width = 1024,
                .height = 664,
                .min_width = 900,
                .min_height = 560,
                .restore_state = true,
                .titlebar = "hidden_inset",
                .views = .{
                    .{ .label = "lab-canvas", .kind = "gpu_surface", .fill = true, .role = "TalkBox canvas", .accessibility_label = "TalkBox", .gpu_backend = "metal", .gpu_pixel_format = "bgra8_unorm", .gpu_present_mode = "timer", .gpu_alpha_mode = "opaque", .gpu_color_space = "srgb", .gpu_vsync = true },
                },
            },
        },
    },
    .security = .{
        .navigation = .{
            .allowed_origins = .{ "zero://app", "zero://inline" },
            .external_links = .{ .action = "deny" },
        },
    },
    .web_engine = "system",
    .cef = .{ .dir = "third_party/cef/macos", .auto_install = false },
}
